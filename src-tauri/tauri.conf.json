{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoA Server Manager",
  "version": "0.1.5",
  "identifier": "com.coa.servermanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CoA Server Manager",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4RERDQTRDMkQzQ0ZBRTIKUldUaStqd3RUTXJkV0VFU2t0ZUZ3Mm1XR2dNQ2grckZrYnlES0k3MHVnTWU5aDlXbmFqT3BjY1IK",
      "endpoints": [
        "https://github.com/Corfirean/coa-server-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
